{
  "name": "novelclaw-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal web reader for NovelClaw translated chapters",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node tests/test-static-ui.js && node tests/test-js-syntax.js && node tests/provider-config-service.test.js",
    "syntax": "node -e \"const{execSync}=require('child_process');const{globSync}=require('fs');console.log(execSync('node --check server.js').toString());const files=require('child_process').execSync('dir /s /b public\\\\js\\\\*.js').toString().trim().split('\\n');files.forEach(f=>{try{require('child_process').execSync('node --check '+f.trim(),{stdio:'pipe'})}catch(e){console.error('FAIL:'+f.trim());process.exit(1)}});console.log('JS syntax: OK')\"",
    "test": "node --check server.js",
    "test:api": "node tests/test-api.js",
    "test:static-ui": "node tests/test-static-ui.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0"
  }
}
